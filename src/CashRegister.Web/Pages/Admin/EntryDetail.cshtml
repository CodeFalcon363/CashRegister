@page "/Admin/Entries/{id:int}"
@model CashRegister.Web.Pages.Admin.EntryDetailModel
@{
    ViewData["Title"] = "Entry Details";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 bg-light border-end min-vh-100 p-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-shield-lock"></i> Admin Panel
                    </h6>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/Admin/Users" class="list-group-item list-group-item-action">
                        <i class="bi bi-people"></i> User Management
                    </a>
                    <a href="/Admin/Entries" class="list-group-item list-group-item-action active">
                        <i class="bi bi-journal-text"></i> Entry Management
                    </a>
                    <a href="/Admin/Branches" class="list-group-item list-group-item-action">
                        <i class="bi bi-building"></i> Branch Management
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-10 p-4">
            @if (Model.Entry == null)
            {
                <div class="alert alert-danger">
                    <h4>Entry Not Found</h4>
                    <p>The requested entry could not be found.</p>
                    <a href="/Admin/Entries" class="btn btn-primary">Back to Entries</a>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2><i class="bi bi-journal-text"></i> Entry Details - ID: @Model.Entry.Id</h2>
                    <a href="/Admin/Entries" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>

                <!-- Entry Information Card -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Entry Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Branch:</strong> @Model.Entry.Branch.BranchName (@Model.Entry.Branch.BranchCode)</p>
                                <p><strong>Entry Date:</strong> @Model.Entry.EntryDate.ToString("yyyy-MM-dd")</p>
                                <p><strong>Created By:</strong> @Model.Entry.CreatedBy.Username</p>
                                <p><strong>Created At:</strong> @Model.Entry.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                            </div>
                            <div class="col-md-6">
                                <p>
                                    <strong>Status:</strong>
                                    @if (Model.Entry.Status == CashRegister.Domain.Enums.EntryStatus.Draft)
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                    else if (Model.Entry.Status == CashRegister.Domain.Enums.EntryStatus.Submitted)
                                    {
                                        <span class="badge bg-warning">Submitted</span>
                                    }
                                    else if (Model.Entry.Status == CashRegister.Domain.Enums.EntryStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (Model.Entry.Status == CashRegister.Domain.Enums.EntryStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </p>
                                @if (Model.Entry.AuthorizedBy != null)
                                {
                                    <p><strong>Authorized By:</strong> @Model.Entry.AuthorizedBy.Username</p>
                                    <p><strong>Authorized At:</strong> @Model.Entry.AuthorizedAt?.ToString("yyyy-MM-dd HH:mm:ss")</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.Entry.RejectionReason))
                                {
                                    <p><strong>Rejection Reason:</strong> <span class="text-danger">@Model.Entry.RejectionReason</span></p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Entry Rows Table -->
                <div class="card">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Cash Entry Rows</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Entry.Rows.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Seq</th>
                                            <th>Type</th>
                                            <th class="text-end">1000</th>
                                            <th class="text-end">500</th>
                                            <th class="text-end">200</th>
                                            <th class="text-end">100</th>
                                            <th class="text-end">50</th>
                                            <th class="text-end">20</th>
                                            <th class="text-end">10</th>
                                            <th class="text-end">5</th>
                                            <th class="text-end">2</th>
                                            <th class="text-end">1</th>
                                            <th class="text-end">Coin</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            decimal runningTotal = 0;
                                        }
                                        @foreach (var row in Model.Entry.Rows.OrderBy(r => r.SequenceOrder))
                                        {
                                            var rowTotal = row.GetTotal();
                                            if (row.IsOutflow) rowTotal = -rowTotal;
                                            runningTotal += rowTotal;
                                            var rowClass = row.IsOutflow ? "table-danger" : "";
                                            <tr class="@rowClass">
                                                <td>@row.SequenceOrder</td>
                                                <td>@row.RowType</td>
                                                <td class="text-end">@(row.Amount1000 > 0 ? row.Amount1000.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount500 > 0 ? row.Amount500.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount200 > 0 ? row.Amount200.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount100 > 0 ? row.Amount100.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount50 > 0 ? row.Amount50.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount20 > 0 ? row.Amount20.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount10 > 0 ? row.Amount10.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount5 > 0 ? row.Amount5.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount2 > 0 ? row.Amount2.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.Amount1 > 0 ? row.Amount1.ToString("N2") : "-")</td>
                                                <td class="text-end">@(row.CoinAmount > 0 ? row.CoinAmount.ToString("N2") : "-")</td>
                                                <td class="text-end fw-bold">@rowTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td colspan="13" class="text-end">Cumulative Total:</td>
                                            <td class="text-end">@runningTotal.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> No rows in this entry.
                            </div>
                        }
                    </div>
                </div>

                <!-- Admin Actions -->
                <div class="card mt-4">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">Admin Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" onclick="changeStatus(@Model.Entry.Id, '@Model.Entry.Status')">
                                <i class="bi bi-arrow-repeat"></i> Change Status
                            </button>
                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this entry? This action cannot be undone.');">
                                <input type="hidden" name="entryId" value="@Model.Entry.Id" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete Entry
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Change Status Modal -->
<div class="modal fade" id="changeStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ChangeStatus">
                <div class="modal-header">
                    <h5 class="modal-title">Change Entry Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="statusEntryId" name="entryId" value="@Model.Entry?.Id" />
                    <div class="mb-3">
                        <label class="form-label">Current Status: <span id="currentStatus" class="fw-bold">@Model.Entry?.Status</span></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Status</label>
                        <select id="newStatus" name="newStatus" class="form-select" required>
                            <option value="Draft">Draft</option>
                            <option value="Submitted">Submitted</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                    </div>
                    <div class="mb-3" id="rejectionReasonDiv" style="display:none;">
                        <label class="form-label">Rejection Reason</label>
                        <textarea id="rejectionReason" name="rejectionReason" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Change Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeStatus(id, currentStatus) {
            document.getElementById('statusEntryId').value = id;
            document.getElementById('currentStatus').textContent = currentStatus;
            document.getElementById('newStatus').value = currentStatus;

            var modal = new bootstrap.Modal(document.getElementById('changeStatusModal'));
            modal.show();
        }

        document.getElementById('newStatus').addEventListener('change', function() {
            var rejectionDiv = document.getElementById('rejectionReasonDiv');
            if (this.value === 'Rejected') {
                rejectionDiv.style.display = 'block';
                document.getElementById('rejectionReason').required = true;
            } else {
                rejectionDiv.style.display = 'none';
                document.getElementById('rejectionReason').required = false;
            }
        });
    </script>
}
