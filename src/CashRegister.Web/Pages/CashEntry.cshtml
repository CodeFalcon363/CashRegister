@page
@model CashRegister.Web.Pages.CashEntryModel
@{
    ViewData["Title"] = "Cash Entry";
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-list"></i> Entry Management</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="/CashEntry?action=create" class="list-group-item list-group-item-action @(Model.Action == "create" ? "active" : "")">
                        <i class="bi bi-pencil"></i> Create/Edit Today's Entry
                    </a>
                    <a href="/CashEntry?status=Draft" class="list-group-item list-group-item-action @(Model.StatusFilter == "Draft" ? "active" : "")">
                        <i class="bi bi-file-earmark"></i> View Saved Drafts
                        @if (Model.AllEntries?.Count(e => e.Status == "Draft") > 0)
                        {
                            <span class="badge bg-secondary float-end">@Model.AllEntries.Count(e => e.Status == "Draft")</span>
                        }
                    </a>
                    <a href="/CashEntry?status=Submitted" class="list-group-item list-group-item-action @(Model.StatusFilter == "Submitted" ? "active" : "")">
                        <i class="bi bi-hourglass-split"></i> View Submitted Entries
                        @if (Model.AllEntries?.Count(e => e.Status == "Submitted") > 0)
                        {
                            <span class="badge bg-warning float-end">@Model.AllEntries.Count(e => e.Status == "Submitted")</span>
                        }
                    </a>
                    <a href="/CashEntry?status=Approved" class="list-group-item list-group-item-action @(Model.StatusFilter == "Approved" ? "active" : "")">
                        <i class="bi bi-check-circle"></i> View Authorized Entries
                        @if (Model.AllEntries?.Count(e => e.Status == "Approved") > 0)
                        {
                            <span class="badge bg-success float-end">@Model.AllEntries.Count(e => e.Status == "Approved")</span>
                        }
                    </a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusFilter) && Model.FilteredEntries?.Any() == true)
            {
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0">@Model.StatusFilter Entries</h6>
                    </div>
                    <div class="list-group list-group-flush" style="max-height: 500px; overflow-y: auto;">
                        @foreach (var entry in Model.FilteredEntries)
                        {
                            var linkUrl = Model.StatusFilter == "Draft"
                                ? $"/CashEntry?action=create&entryId={entry.EntryId}"
                                : $"/CashEntry?entryId={entry.EntryId}&status={Model.StatusFilter}";
                            <a href="@linkUrl"
                               class="list-group-item list-group-item-action @(Model.Entry?.EntryId == entry.EntryId ? "active" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@entry.EntryDate.ToString("yyyy-MM-dd")</h6>
                                    <small>
                                        @if (entry.Status == "Draft")
                                        {
                                            <span class="badge bg-secondary">Draft</span>
                                        }
                                        else if (entry.Status == "Submitted")
                                        {
                                            <span class="badge bg-warning">Submitted</span>
                                        }
                                        else if (entry.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                    </small>
                                </div>
                                @if (entry.WasRejected())
                                {
                                    <small class="text-danger"><i class="bi bi-exclamation-triangle"></i> Previously Rejected</small>
                                }
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Main Content -->
        <div class="col-md-9">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }

            @if (Model.Entry != null && Model.Entry.EntryId.HasValue)
            {
                <!-- Entry is loaded - show either editable or read-only view -->
                <div class="row mb-3">
                    <div class="col">
                        <h3>Daily Cash Entry - @Model.Entry.EntryDate.ToString("yyyy-MM-dd")</h3>
                        <p class="text-muted">Status: <strong>@Model.Entry.Status</strong></p>
                    </div>
                    <div class="col text-end">
                        @if (Model.Entry.Status == "Draft")
                        {
                            <button type="button" class="btn btn-primary" id="saveBtn">Save Draft</button>
                            <button type="button" class="btn btn-success" id="submitBtn">Submit for Authorization</button>
                        }
                        else if (Model.Entry.Status == "Approved")
                        {
                            <span class="badge bg-success fs-5">Approved</span>
                        }
                        else if (Model.Entry.Status == "Submitted")
                        {
                            <span class="badge bg-warning fs-5">Pending Authorization</span>
                        }
                    </div>
                </div>

                @if (Model.Entry.WasRejected())
                {
                    <div class="alert alert-warning">
                        <h5 class="alert-heading">
                            <i class="bi bi-exclamation-triangle-fill"></i> This Entry Was Previously Rejected
                        </h5>
                        <p class="mb-1"><strong>Rejected By:</strong> @Model.Entry.AuthorizedBy?.Username</p>
                        <p class="mb-1"><strong>Rejected At:</strong> @Model.Entry.AuthorizedAt?.ToString("yyyy-MM-dd HH:mm")</p>
                        <p class="mb-0"><strong>Reason:</strong> @Model.Entry.RejectionReason</p>
                        <hr />
                        <p class="mb-0 small">You can make necessary corrections and resubmit this entry for authorization.</p>
                    </div>
                }

                @if (Model.Entry.Status == "Draft")
                {
                    <!-- Editable table for Draft entries -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm cash-entry-table" id="cashEntryTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 200px;">Description</th>
                                    <th style="width: 100px;">N1000</th>
                                    <th style="width: 100px;">N500</th>
                                    <th style="width: 100px;">N200</th>
                                    <th style="width: 100px;">N100</th>
                                    <th style="width: 100px;">N50</th>
                                    <th style="width: 100px;">N20</th>
                                    <th style="width: 100px;">N10</th>
                                    <th style="width: 100px;">N5</th>
                                    <th style="width: 100px;">N2</th>
                                    <th style="width: 100px;">N1</th>
                                    <th style="width: 100px;">Coin</th>
                                    <th style="width: 120px;">Total</th>
                                    <th style="width: 120px;">Cumulative Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Entry.Rows.Count; i++)
                                {
                                    var row = Model.Entry.Rows[i];
                                    var rowClass = row.IsOutflow ? "text-danger fw-bold" : "";
                                    var isReadOnly = row.RowType == "Vault Figure" || row.RowType == "Till Total" || row.RowType == "Vault Closing Balance";
                                    var isOpeningOrTillOut = row.RowType == "Opening Balance" || row.RowType == "Till Out";

                                    <tr data-row-index="@i" data-row-type="@row.RowType" data-is-outflow="@row.IsOutflow.ToString().ToLower()" data-is-readonly="@isReadOnly.ToString().ToLower()">
                                        <td class="@rowClass">@row.RowType</td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="1000" value="@row.Amount1000" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="500" value="@row.Amount500" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="200" value="@row.Amount200" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="100" value="@row.Amount100" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="50" value="@row.Amount50" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="20" value="@row.Amount20" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="10" value="@row.Amount10" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="5" value="@row.Amount5" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="2" value="@row.Amount2" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="1" value="@row.Amount1" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="number" class="form-control form-control-sm denomination-input" data-denomination="coin" value="@row.CoinAmount" @(isReadOnly || isOpeningOrTillOut ? "readonly" : "") /></td>
                                        <td><input type="text" class="form-control form-control-sm row-total" readonly /></td>
                                        <td><input type="text" class="form-control form-control-sm cumulative-total" readonly /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <input type="hidden" id="entryId" value="@Model.Entry.EntryId" />
                    <input type="hidden" id="entryDate" value="@Model.Entry.EntryDate.ToString("yyyy-MM-dd")" />
                    @Html.AntiForgeryToken()
                }
                else
                {
                    <!-- Read-only view for Submitted/Approved entries -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Seq</th>
                                    <th>Type</th>
                                    <th class="text-end">1000</th>
                                    <th class="text-end">500</th>
                                    <th class="text-end">200</th>
                                    <th class="text-end">100</th>
                                    <th class="text-end">50</th>
                                    <th class="text-end">20</th>
                                    <th class="text-end">10</th>
                                    <th class="text-end">5</th>
                                    <th class="text-end">2</th>
                                    <th class="text-end">1</th>
                                    <th class="text-end">Coin</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    decimal runningTotal = 0;
                                }
                                @foreach (var row in Model.Entry.Rows.OrderBy(r => r.SequenceOrder))
                                {
                                    decimal rowTotal = row.Amount1000 + row.Amount500 + row.Amount200 + row.Amount100 + row.Amount50 + row.Amount20 + row.Amount10 + row.Amount5 + row.Amount2 + row.Amount1 + row.CoinAmount;
                                    if (row.IsOutflow) rowTotal = -rowTotal;
                                    runningTotal += rowTotal;
                                    var rowClass = row.IsOutflow ? "table-danger" : "";
                                    <tr class="@rowClass">
                                        <td>@row.SequenceOrder</td>
                                        <td>@row.RowType</td>
                                        <td class="text-end">@(row.Amount1000 > 0 ? row.Amount1000.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount500 > 0 ? row.Amount500.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount200 > 0 ? row.Amount200.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount100 > 0 ? row.Amount100.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount50 > 0 ? row.Amount50.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount20 > 0 ? row.Amount20.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount10 > 0 ? row.Amount10.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount5 > 0 ? row.Amount5.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount2 > 0 ? row.Amount2.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.Amount1 > 0 ? row.Amount1.ToString("N2") : "-")</td>
                                        <td class="text-end">@(row.CoinAmount > 0 ? row.CoinAmount.ToString("N2") : "-")</td>
                                        <td class="text-end fw-bold">@rowTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="13" class="text-end">Cumulative Total:</td>
                                    <td class="text-end">@runningTotal.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            }
            else if (!string.IsNullOrEmpty(Model.StatusFilter) && Model.FilteredEntries?.Any() == true)
            {
                <!-- Filtered list is shown but no entry selected -->
                <div class="card">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-arrow-left-circle fs-1 mb-3"></i>
                        <p class="fs-5">Select an entry from the list to view details</p>
                    </div>
                </div>
            }
            else
            {
                <!-- Empty state - no action taken -->
                <div class="card">
                    <div class="card-body text-center text-muted py-5">
                        <i class="bi bi-journal-text fs-1 mb-3"></i>
                        <h4>Welcome to Cash Entry Management</h4>
                        <p class="mt-3">Select an option from the sidebar to get started:</p>
                        <ul class="list-unstyled mt-4">
                            <li class="mb-2"><i class="bi bi-pencil text-primary"></i> <strong>Create/Edit Today's Entry</strong> - Create or edit today's cash entry</li>
                            <li class="mb-2"><i class="bi bi-file-earmark text-secondary"></i> <strong>View Saved Drafts</strong> - Review and edit your draft entries</li>
                            <li class="mb-2"><i class="bi bi-hourglass-split text-warning"></i> <strong>View Submitted Entries</strong> - Check entries pending authorization</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> <strong>View Authorized Entries</strong> - See approved entries</li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cashentry.js" asp-append-version="true"></script>
}

<style>
    .cash-entry-table input[readonly] {
        background-color: #e9ecef;
    }

    .cash-entry-table .denomination-input {
        text-align: right;
    }

    .cash-entry-table .row-total,
    .cash-entry-table .cumulative-total {
        text-align: right;
        font-weight: bold;
    }

    .table-sm td {
        padding: 0.25rem;
    }

    /* Red styling for outflow rows */
    tr[data-is-outflow="true"] td:first-child {
        color: #dc3545;
        font-weight: bold;
    }

    tr[data-is-outflow="true"] .denomination-input,
    tr[data-is-outflow="true"] .row-total {
        color: #dc3545;
        font-weight: bold;
    }
</style>
